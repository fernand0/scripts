#!/bin/bash
set -e

VENV_DIR="$HOME/.errbot-ve-new"
ERRBOT_CONFIG="$HOME/usr/var/err/config.py"
ERRBOT_DATA_DIR="$HOME/usr/var/err/"

# Crear el entorno virtual si no existe
if [ ! -d "$VENV_DIR" ]; then
  echo "El entorno virtual '$VENV_DIR' no existe. Creándolo..."
  uv venv "$VENV_DIR"
  uv pip install --python "$VENV_DIR/bin/python" -m ensurepip
fi

# Instalar/actualizar dependencias
uv pip install --python "$VENV_DIR/bin/python" errbot 'errbot[telegram]' "social-modules @ git+https://github.com/fernand0/socialModules.git"

# Ejecutar errbot como daemon
cd "$ERRBOT_DATA_DIR"
"$VENV_DIR/bin/errbot" -c "$ERRBOT_CONFIG" -d
